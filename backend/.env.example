# Zen World Hospitality Backend Configuration
# Copy this file to .env and fill in real values.
# AVOID committing .env — it holds live credentials.

# ── Database ─────────────────────────────────────────────────────────────
# REQUIRED. The app fails to start without it (no insecure default).
# Local SQLite quick-start:
# DATABASE_URL=sqlite+aiosqlite:///./zen_hospitality.db
# Production PostgreSQL:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/zenhospitality

# ── Google Gemini AI (AI Trip Planner / Chatbot) ─────────────────────────
GEMINI_API_KEY=

# AI Models (August 2026 releases; optional - defaults below)
GEMINI_ITINERARY_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.1-pro

# ── Frontend CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:5173

# ── Admin portal credentials (REQUIRED) ─────────────────────────────────
# The app fails to start without these.
ADMIN_USERNAME=zenhospi
ADMIN_PASSWORD=Zen@2804

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false

# JWT signing secret — REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret