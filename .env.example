# ────────────────────────────────────────────────────────────────
# Zen World Hospitality — environment template
# Copy to .env (and/or the hosting control panel's env vars) and fill real values.
# NEVER commit .env — it holds live credentials.
# ────────────────────────────────────────────────────────────────

# ── Backend ─────────────────────────────────────────────────────
# PostgreSQL. Defaults to the service account; override the whole URL in prod.
DATABASE_URL=postgresql+asyncpg://postgresql:Poonam%40125@localhost:5432/zenhospitality

# Google Gemini API Key (AI Itinerary Generator + Chatbot)
GEMINI_API_KEY=

# Comma-separated allowed browser origin(s) for CORS
FRONTEND_URL=https://hostycare.online

# App
DEBUG=false
# Strong random secret for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Admin portal credentials (defaults used if unset)
ADMIN_USERNAME=zenhospi
ADMIN_PASSWORD=Zen@2804

# ── Frontend (build-time, consumed by Vite) ─────────────────────
# Public base URL the built app is served from (https + no trailing slash)
VITE_BASE_URL=https://hostycare.online
# Backend API base URL the browser should call (includes /api suffix)
VITE_API_URL=https://api.hostycare.online/api