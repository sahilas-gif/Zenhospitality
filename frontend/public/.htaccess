# ──────────────────────────────────────────────────────────────
# Zen World Hospitality — React SPA routing for Apache (hostycare.online)
# This file ships inside dist/, so upload it alongside index.html.
# Without it, deep URLs (e.g. /domestic-tours) return 404 on refresh.
# ──────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase is a no-op if empty
  RewriteBase /

  # Crawlable hotel pages, sitemap and robots come from the API (same SPA shell + meta tags)
  RewriteRule ^hotels/?$ /api/seo/hotels [L,QSA]
  RewriteRule ^hotels/([a-z0-9-]+)/?$ /api/seo/hotels/$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ /api/seo/sitemap.xml [L]
  RewriteRule ^robots\.txt$ /api/seo/robots.txt [L]

  # Let real files / directories through as-is (fonts, images, JS, CSS)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exclude /api from SPA rewrite (cPanel Python app Passenger handles /api via public_html/api/.htaccess)
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^ - [L]

  # Everything else → serve the SPA shell
  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Browser caching for hashed build assets ────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Prevent serving sensitive dotfiles ─────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Never serve archives, databases or backups from the web root ─
<FilesMatch "\.(zip|tar|gz|db|sqlite3?|bak|sql|py|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>